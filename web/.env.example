# Copy to .env.local and fill in. Never commit real values.

# Supabase (local: values printed by `supabase start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback used only when the publishable key is blank
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Document storage: SUPABASE (default) or DRIVE.
# DRIVE stays inactive unless DRIVE_RUNTIME_VERIFIED=true and every value below is set.
DOCUMENT_STORAGE_PROVIDER=SUPABASE
DRIVE_RUNTIME_VERIFIED=false
APP_ORIGIN=http://localhost:3000
DRIVE_GATEWAY_ORIGIN=
# At least 32 characters; must match the gateway worker secret.
DRIVE_GRANT_SECRET=
DRIVE_WORKER_TOKEN=

# Background jobs: the gateway worker's cron calls /api/cron/* with this secret.
# At least 32 characters; must match the worker's CRON_SECRET. Unset = routes reject.
CRON_SECRET=
# JWT whose role claim is storage_cleanup_worker (legacy Supabase Storage cleanup).
STORAGE_CLEANUP_WORKER_TOKEN=
